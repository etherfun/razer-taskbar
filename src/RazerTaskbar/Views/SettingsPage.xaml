<Page
    x:Class="RazerTaskbar.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Stretch: the cards must FILL the content area at any window
             width (Center would size the panel to its ~450px desired width
             and waste the rest of the window). -->
        <StackPanel Margin="16,8,16,16" Spacing="4">

            <!-- ============ Widget ============ -->
            <TextBlock x:Name="HeaderWidget" Style="{StaticResource SettingsSectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="2">
                    <!-- Show widget -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblWidget" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescWidget" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchWidget" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchWidget_Toggled" />
                    </Grid>
                    <!-- Display mode -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblDisplayMode" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescDisplayMode" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboDisplayMode" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                  SelectionChanged="ComboDisplayMode_SelectionChanged" />
                    </Grid>
                    <!-- Shown device -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblShownDevice" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescShownDevice" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboDevice" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                  SelectionChanged="ComboDevice_SelectionChanged" />
                    </Grid>
                    <!-- Swap duration (drop_swap mode only) -->
                    <Grid x:Name="RowSwapDur" Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblSwapDur" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescSwapDur" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboSwapDur" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  SelectionChanged="ComboSwapDur_SelectionChanged" />
                    </Grid>
                    <!-- Rotate interval (rotate mode only) -->
                    <Grid x:Name="RowRotI" Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblRotI" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescRotI" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboRotI" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  SelectionChanged="ComboRotI_SelectionChanged" />
                    </Grid>
                    <!-- Widget side -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblSide" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescSide" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboSide" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  SelectionChanged="Side_SelectionChanged" />
                    </Grid>
                    <!-- Embed in widgets free space -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblEmbedWidgets" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescEmbedWidgets" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchEmbedWidgets" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchEmbedWidgets_Toggled" />
                    </Grid>
                    <!-- Embed into the taskbar (true band child) -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblEmbedTaskbar" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescEmbedTaskbar" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchEmbedTaskbar" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchEmbedTaskbar_Toggled" />
                    </Grid>
                    <!-- Show estimated time -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblEst" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescEst" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchEst" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchEst_Toggled" />
                    </Grid>
                    <!-- Colored battery icon -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblColor" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescColor" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchColor" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchColor_Toggled" />
                    </Grid>
                    <!-- Fade transition -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblFade" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescFade" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchFade" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchFade_Toggled" />
                    </Grid>
                    <!-- Show tray icon -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblTray" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescTray" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchTray" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchTray_Toggled" />
                    </Grid>
                    <!-- Hover devices -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblHover" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescHover" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchHover" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchHover_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ History ============ -->
            <TextBlock x:Name="HeaderHistory" Style="{StaticResource SettingsSectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="2">
                    <!-- Poll interval -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblPoll" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescPoll" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboPoll" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  SelectionChanged="ComboPoll_SelectionChanged" />
                    </Grid>
                    <!-- Record battery history -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblRec" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescRec" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchRec" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchRec_Toggled" />
                    </Grid>
                    <!-- Record interval -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblRecI" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescRecI" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboRecI" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  SelectionChanged="ComboRecI_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ General ============ -->
            <TextBlock x:Name="HeaderGeneral" Style="{StaticResource SettingsSectionStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="2">
                    <!-- Language -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblLang" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescLang" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ComboLang" Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  SelectionChanged="ComboLang_SelectionChanged" />
                    </Grid>
                    <!-- Run at startup -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LblAutostart" Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock x:Name="DescAutostart" Style="{StaticResource SettingDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchAutostart" Grid.Column="1" VerticalAlignment="Center"
                                      Toggled="SwitchAutostart_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
